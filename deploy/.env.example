# ---- Domaine (Traefik + Let's Encrypt) ----
# Le backend sera servi sur https://rag.${DOMAIN}
DOMAIN=aicarreerfinder.com

# ---- Environnement ----
ENVIRONMENT=production
PROJECT_NAME=RAG Assistant
# Origines autorisées (CORS) — front qui appellera l'API, séparées par des virgules.
BACKEND_CORS_ORIGINS=https://rag.aicarreerfinder.com
FRONTEND_HOST=https://rag.aicarreerfinder.com

# ---- Sécurité / superuser (à changer impérativement) ----
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
FIRST_SUPERUSER=admin@aicarreerfinder.com
FIRST_SUPERUSER_PASSWORD=CHANGE_ME_strong_password

# ---- Base de données (service "db" du compose) ----
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ---- RAG : LLM ----
# "ollama" = local via l'Ollama mutualisé (défaut, aucune clé) ; "mistral" = API cloud.
RAG_LLM_PROVIDER=ollama
# Modèle de chat léger (RAM-friendly sur VPS partagé). Alternatives : mistral:latest, llama3.2:3b.
RAG_LLM_MODEL=qwen2.5:3b
# Ollama mutualisé du stack job-search-ai (conteneur jsa-ollama, réseau job-search-ai_default).
OLLAMA_BASE_URL=http://jsa-ollama:11434
# Requis uniquement si RAG_LLM_PROVIDER=mistral :
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# ---- RAG : reranker (laisser tel quel) ----
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- Divers (optionnels) ----
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
SENTRY_DSN=
SQLALCHEMY_ECHO=false
